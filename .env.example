# Game state lives in Redis, reached over HTTP through Webdis (https://webd.is).
# Leave blank locally to use in-memory storage (single process only).
WEBDIS_URL=
# HTTP basic auth for Webdis (sent as the Authorization header).
WEBDIS_USERNAME=
WEBDIS_PASSWORD=

# Cloudflare Access service token, if Webdis sits behind Cloudflare Access.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Optional: any other headers to send, as a JSON object.
# WEBDIS_HEADERS={"X-Example":"value"}
